[Desktop Entry]
Type=Application
Name=Thinkspace
GenericName=Visual idea workspace
Comment=Combine images, lines and layers to show what you mean
Exec=thinkspace %F
Icon=thinkspace
Terminal=false
Categories=Graphics;
MimeType=application/x-thinkspace;image/png;image/jpeg;
StartupWMClass=io.github.remco28.thinkspace
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=thinkspace
